# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/

# Firebase client config (google-services.json, GoogleService-Info.plist) is
# intentionally NOT excluded here — these are client-side only, contain no
# private key, and are embedded in the APK/IPA binary anyway. EAS Build needs
# them git-tracked to include them in the build.
# The admin service account JSON (labtraca-service-account.json) IS sensitive
# and must stay out of git — that is excluded in the backend repo's .gitignore.

# EAS / Android signing credentials — contain keystore passwords
credentials.json
credentials/

# Environment
.env
.env.*
expo-env.d.ts

# Native
/android
/ios
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo
